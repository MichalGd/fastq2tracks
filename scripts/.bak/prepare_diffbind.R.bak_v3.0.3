#!/usr/bin/env Rscript
# =============================================================================
# fastq2tracks v3.0.2 — DiffBind sample sheet preparation (narrow + broad)
# Usage: Rscript scripts/prepare_diffbind.R <ss.csv> <bamDir> <peaksDir> <outDir> <genome>
# Produces: diffbind_samplesheet_<genome>_narrow.csv
#           diffbind_samplesheet_<genome>_broad.csv
# =============================================================================
suppressPackageStartupMessages(library(dplyr))
args <- commandArgs(trailingOnly = TRUE)
if (length(args) < 5) stop("Usage: prepare_diffbind.R <ss.csv> <bamDir> <peaksDir> <outDir> <genome>")

ss_file <- args[1]; bam_dir <- args[2]; peaks_dir <- args[3]
out_dir <- args[4]; genome  <- tolower(args[5])
dir.create(out_dir, showWarnings=FALSE, recursive=TRUE)

ss    <- read.csv(ss_file, stringsAsFactors=FALSE)
ss    <- ss[tolower(ss$genome) == genome, ]
ss_ip <- ss[tolower(ss$is_control) %in% c("false","0","no"), ]
ss_ip <- ss_ip[!duplicated(ss_ip$sample_id), ]   # collapse tech-rep rows

make_bam <- function(sid, rep, dir) {
    p <- file.path(dir, paste0(sid, "_bioR", rep, "_dedup_blFilt.bam"))
    if (!file.exists(p)) p <- file.path(dir, paste0(sid, "_bioR", rep, "_dedup.bam")); p
}
make_peak <- function(sid, peaks_dir, ptype) {
    p <- file.path(peaks_dir, "per_replicate", sid, ptype,
                   paste0(sid, "_peaks.", ptype, "Peak"))
    if (file.exists(p)) p else NA_character_
}
build_ss <- function(ptype) {
    do.call(rbind, lapply(seq_len(nrow(ss_ip)), function(i) {
        sid <- ss_ip$sample_id[i]; ctrl_id <- ss_ip$control_id[i]
        data.frame(SampleID=sid, Tissue=ss_ip$cell_type[i], Factor=ss_ip$factor[i],
                   Condition=ss_ip$condition[i], Treatment=ss_ip$treatment[i],
                   Replicate=ss_ip$replicate[i], bamReads=make_bam(sid, ss_ip$replicate[i], bam_dir),
                   ControlID=ifelse(is.na(ctrl_id)|nchar(ctrl_id)==0, NA_character_, ctrl_id),
                   bamControl=ifelse(is.na(ctrl_id)|nchar(ctrl_id)==0, NA_character_,
                                     make_bam(ctrl_id, ss[ss$sample_id==ctrl_id,"replicate"][1], bam_dir)),
                   Peaks=make_peak(sid, peaks_dir, ptype), PeakCaller=ptype,
                   stringsAsFactors=FALSE)
    }))
}
for (ptype in c("narrow","broad")) {
    db_ss    <- build_ss(ptype)
    out_file <- file.path(out_dir, paste0("diffbind_samplesheet_", genome, "_", ptype, ".csv"))
    write.csv(db_ss, out_file, row.names=FALSE)
    cat("Written:", out_file, "(", nrow(db_ss), "samples)\n")
    missing <- c(db_ss$bamReads[!file.exists(db_ss$bamReads)],
                 db_ss$Peaks[!is.na(db_ss$Peaks) & !file.exists(db_ss$Peaks)])
    if (length(missing) > 0) { cat("WARNING — not yet present:\n"); cat(missing, sep="\n"); cat("\n") }
}
